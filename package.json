{
  "name": "api-response-standard",
  "version": "1.1.0",
  "description": "Consistent REST API success/error envelopes with stable error codes and default messages",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "api",
    "response",
    "error-codes",
    "rest",
    "express",
    "http",
    "standard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rashh-sikun/api-response-standard.git"
  },
  "bugs": {
    "url": "https://github.com/rashh-sikun/api-response-standard/issues"
  },
  "homepage": "https://github.com/rashh-sikun/api-response-standard#readme",
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
